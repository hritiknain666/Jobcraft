{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "incremental": false,
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ES2022",
    "outDir": ".test-build",
    "rootDir": ".",
    "isolatedModules": false
  },
  "include": [
    "lib/skill-match.ts",
    "lib/auth/navigation.ts",
    "lib/uploads/file-validation.ts",
    "lib/job-match.ts",
    "lib/job-sources/config.ts",
    "lib/job-sources/extract-metadata.ts",
    "lib/job-sources/india-eligibility.ts",
    "lib/job-sources/plain-text.ts",
    "lib/job-sources/types.ts",
    "lib/job-sources/normalize.ts",
    "lib/job-sources/source-kind.ts",
    "lib/job-sources/validate.ts",
    "lib/job-sources/fetch-arbeitnow.ts",
    "lib/job-sources/fetch-greenhouse.ts",
    "lib/job-sources/fetch-jooble.ts",
    "lib/job-sources/fetch-lever.ts",
    "lib/job-sources/fetch-remotive.ts",
    "lib/job-sources/fetch-theirstack.ts",
    "lib/job-sources/providers/arbeitnow.ts",
    "lib/job-sources/providers/greenhouse.ts",
    "lib/job-sources/providers/jooble.ts",
    "lib/job-sources/providers/lever.ts",
    "lib/job-sources/providers/remotive.ts",
    "lib/job-sources/providers/theirstack.ts",
    "tests/**/*.ts"
  ],
  "exclude": ["node_modules", ".next", ".open-next"]
}
