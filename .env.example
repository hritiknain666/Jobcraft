NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
NEXT_PUBLIC_SITE_URL=https://YOUR_JOBCRAFT_DOMAIN

# Server-only. Never expose these with NEXT_PUBLIC_ prefixes.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
JOB_IMPORT_SECRET=YOUR_LONG_RANDOM_IMPORT_SECRET

# Free/public sources. Leave enabled unless an incident requires a temporary kill switch.
FREE_PUBLIC_JOB_SOURCES_ENABLED=true

# Adzuna: free quota, credentials required.
ADZUNA_APP_ID=YOUR_ADZUNA_APP_ID
ADZUNA_APP_KEY=YOUR_ADZUNA_APP_KEY
# Keep both false until a controlled provider preview is verified.
# ADZUNA_PUBLISHING_READY means provider/commercial use is approved for JobCraft.
ADZUNA_PUBLISHING_READY=false
# Enable only after the required "Jobs by Adzuna" + official logo attribution
# has been implemented and visually checked wherever Adzuna adverts are shown.
ADZUNA_ATTRIBUTION_READY=false

# IndianAPI Jobs: free API key from the IndianAPI dashboard.
INDIANAPI_JOBS_API_KEY=YOUR_INDIANAPI_JOBS_API_KEY

# Jooble REST API: free key requested from Jooble's API registration page.
JOOBLE_API_KEY=YOUR_JOOBLE_API_KEY

# TheirStack: free plan currently includes a limited monthly API-credit allowance.
THEIRSTACK_API_KEY=YOUR_THEIRSTACK_API_KEY

# Greenhouse public GET API. Comma-separated board URL tokens we explicitly support.
# Example: GREENHOUSE_BOARD_TOKENS=companyone,companytwo
GREENHOUSE_BOARD_TOKENS=

# Lever public postings API. Comma-separated `site|Company Name` pairs.
# Example: LEVER_SITES=companyone|Company One,companytwo|Company Two
LEVER_SITES=
